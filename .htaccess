<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Force HTTPS jika diakses melalui HTTP pada domain pusimpel.com
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?pusimpel\.com$ [NC]
    RewriteRule ^(.*)$ https://pusimpel.com/absensids/$1 [R=301,L]

    # 2. Redirect mixed/uppercase /ABSENSIDS ke lowercase /absensids/
    RewriteCond %{REQUEST_URI} ^/absensids [NC]
    RewriteCond %{REQUEST_URI} !^/absensids
    RewriteRule ^(.*)$ https://pusimpel.com/absensids/$1 [R=301,L]

    # 3. Blokir akses langsung ke file konfigurasi sensitif dan kode internal
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|boost\.json) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^storage/(framework|logs)(?:/|$) - [F,L,NC]
    RewriteRule \.(sql|log|cache|iml|bak)$ - [F,L,NC]

    # 4. Redirect /public atau /public/index.php ke URL bersih tanpa /public
    RewriteCond %{THE_REQUEST} \s/absensids/public(?:/index\.php)?/?([^\s?]*) [NC]
    RewriteRule ^ /absensids/%1 [R=301,L,NE]

    # 5. Redirect permintaan langsung /index.php ke URL bersih
    RewriteCond %{THE_REQUEST} \s/absensids/index\.php/?([^\s?]*) [NC]
    RewriteRule ^ /absensids/%1 [R=301,L,NE]

    # 6. Teruskan header Authorization dan CSRF
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 7. Rewrite semua permintaan secara internal ke folder public
    RewriteCond %{REQUEST_URI} !^/absensids/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
